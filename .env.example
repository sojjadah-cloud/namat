# ─────────────────────────────────────────────────────────────────────────────
# NAMAT — environment
#
# Copy to `.env` and fill in. Never commit the filled copy: `.env*` is ignored
# except for this template.
# ─────────────────────────────────────────────────────────────────────────────

# --- Database ---------------------------------------------------------------
# Any PostgreSQL connection string. `npx prisma dev` runs a local one.
DATABASE_URL="postgres://user:password@localhost:5432/namat"

# --- Auth -------------------------------------------------------------------
# Signs session tokens AND the phone-verification challenge. Rotating it logs
# everyone out and invalidates codes in flight, which is the intended effect.
# Generate with:  openssl rand -base64 32
AUTH_SECRET=""

# --- Site -------------------------------------------------------------------
# Absolute origin, used for sitemap.xml, robots.txt, canonical URLs and the
# payment return URLs. Without it those fall back to localhost in production.
NEXT_PUBLIC_SITE_URL="https://namat.om"

# --- SMS --------------------------------------------------------------------
# "console" prints codes to the server log and refuses to run in production.
# "twilio" sends real messages.
SMS_PROVIDER="console"

# Required when SMS_PROVIDER=twilio.
# TWILIO_FROM accepts a purchased number (+968…) or a Messaging Service SID (MG…).
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""

# --- Payments ---------------------------------------------------------------
# "manual" skips the gateway and marks payments as settled — development only.
# "thawani" uses Thawani Pay.
PAYMENT_PROVIDER="manual"

# Required when PAYMENT_PROVIDER=thawani.
# THAWANI_MODE selects the UAT sandbox or live checkout host.
# The secret key must never reach the browser; the publishable key is a query
# parameter on the hosted checkout URL and is safe to expose.
THAWANI_MODE="test"
THAWANI_SECRET_KEY=""
THAWANI_PUBLISHABLE_KEY=""
